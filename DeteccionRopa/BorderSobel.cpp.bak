#include <opencv2/highgui/highgui.hpp>
#include <opencv2/imgproc/imgproc.hpp>  // Necesario para applyColorMap
#include <opencv2/opencv.hpp>           // Necesario para calcHist
#include <iostream>
#include <vector>
#include <algorithm> 					// Necesario para std::sort

#include "BorderSobel.h"

using namespace std;
using namespace cv;

#define IMAGEN "C:\\AAAA\\OpenCV\\images\\"

Mat imagen;
Mat imageGray;
Mat imageEdited;

string imageName = " ";
char* imageChar;
 
void ChargeImage()
{
    cout << "Enter image name (.jpg format)" << endl;
    cin >> imageName;
    // Nombre de la imagen que se va a cargar
    string path = IMAGEN + imageName + ".jpg";

    //{ para cargar la ruta de la imagen (necesitamos char* en vez de string)
    vector<char> imageChar(path.begin(), path.end());
    imageChar.push_back('\0');
    char* cstr = imageChar.data();
    //}

    // Se carga la imagen desde disco y se comprueba que lo ha hecho correctamente
    //imagen = imread(path);

    // Se carga la imagen desde disco en escala de grises
    imageGray = imread(path, IMREAD_GRAYSCALE);

    imagen = imread(path, IMREAD_COLOR);

    if (!imagen.data) {
        cout << "Error al cargar la imagen: " << path << endl;
        exit(1);
    }

    // namedWindow("Original", WINDOW_AUTOSIZE);
    // imshow("Original", imagen);
    // waitKey(0);


    //imageEdited = imagen.clone(); // Copia de la imagen original para editarla
	// Inicializamos imageEdited para que Sobel tenga donde escribir
    imageEdited = Mat::zeros(imageGray.size(), imageGray.type());
    
	// 1. Aplicamos el filtro Sobel
    // Esto llena 'imageEdited' con los bordes detectados
    BorderSobel();
    Mat imagenSobel = imageEdited.clone();

    // 2. Detectamos esquinas basándonos en el Sobel y ordenamos
    DetectarEsquinasCaja();

    Mat imagenSobelColor;
    // Convertimos la imagen de Sobel (gris) a Color (BGR) para poder unirla con la otra
    cvtColor(imagenSobel, imagenSobelColor, COLOR_GRAY2BGR); 

    Mat imagenCombinada;
    // Concatenamos horizontalmente: Sobel a la izq, Resultado a la der
    hconcat(imagenSobelColor, imageEdited, imagenCombinada);

    namedWindow("Panel de Control", WINDOW_AUTOSIZE);
    imshow("Panel de Control", imagenCombinada);
    waitKey(0);
}

void BorderSobel()
{
    Mat grad_x, grad_y;
    Mat abs_grad_x, abs_grad_y;
    // Gradiente en la dirección X
    Sobel(imageGray, grad_x, CV_16S, 1, 0, 3);
    convertScaleAbs(grad_x, abs_grad_x);
    // Gradiente en la dirección Y
    Sobel(imageGray, grad_y, CV_16S, 0, 1, 3);
    convertScaleAbs(grad_y, abs_grad_y);
    // Combina ambos gradientes
    addWeighted(abs_grad_x, 0.5, abs_grad_y, 0.5, 0, imageEdited);
}

// Detecta esquinas y las imprime con origen (0,0) en inferior-izquierda
void DetectarEsquinasCaja()
{
    // 1. Parámetros de detección
    int maxCorners = 20;        // Máximo número de esquinas a encontrar (caja + separadores)
    double qualityLevel = 0.1; 	// Calidad mínima de la esquina (estándar)
    double minDistance = 50;    // Distancia mínima en píxeles entre esquinas (para evitar duplicados muy cerca)

    vector<Point2f> corners;

    // 2. Detección sobre el resultado de Sobel
    // En este punto, 'imageEdited' contiene la imagen con el filtro Sobel aplicado.
    // Al detectar sobre Sobel, se encuentran muy bien las intersecciones de líneas.
    goodFeaturesToTrack(imageEdited, corners, maxCorners, qualityLevel, minDistance, Mat(), 3, false, 0.04);

    // 3. Ordenar las esquinas respecto al origen (0,0) INFERIOR IZQUIERDA
    // Obtenemos la altura para la transformación matemática
    float alturaImagen = (float)imagen.rows;

    // Usamos una función lambda para ordenar el vector
    sort(corners.begin(), corners.end(), [alturaImagen](Point2f a, Point2f b) {
        // Transformar coordenadas Y (OpenCV arriba -> Abajo real)
        float ay = alturaImagen - a.y;
        float by = alturaImagen - b.y;
        
        // Distancia al cuadrado desde (0,0) = x^2 + y^2 (Pitágoras)
        // No hace falta la raíz cuadrada para comparar quien es mayor
        float distA = (a.x * a.x) + (ay * ay);
        float distB = (b.x * b.x) + (by * by);

        return distA < distB; // Orden ascendente (el más cercano primero)
    });

    // 4. Visualización
    // Volvemos a copiar la imagen original a color en imageEdited para 
    // pintar los resultados sobre la foto real y que se vea bonito.
    imageEdited = imagen.clone(); 

    cout << "--- ESQUINAS ORDENADAS (Desde Inferior-Izquierda) ---" << endl;
    
    for (size_t i = 0; i < corners.size(); i++)
    {
        // Coordenadas transformadas para mostrar por pantalla
        float x_real = corners[i].x;
        float y_real = alturaImagen - corners[i].y;

        cout << "Punto " << i + 1 << ": (" << x_real << ", " << y_real << ")" << endl;

        // Dibujar: Círculo rojo lleno
        circle(imageEdited, corners[i], 5, Scalar(0, 0, 255), -1);
        
        // Escribir el número de orden en la imagen
        putText(imageEdited, to_string((int)i + 1), corners[i] + Point2f(5, -5), 
                FONT_HERSHEY_SIMPLEX, 0.5, Scalar(255, 255, 0), 1);
    }
    cout << "----------------------------------------------------" << endl;
}